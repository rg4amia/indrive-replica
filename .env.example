# Variables du projet : noms seulement, aucune valeur. Copier vers .env.local (ignoré par Git) et remplir
# avec VOS propres clés. Claude n'a ni créé de compte ni saisi de clé.

# --- Supabase (projet créé par vous ; en local, `supabase status -o env` donne ces valeurs) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role : serveur uniquement. Ne jamais l'embarquer dans l'app mobile.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application Flutter (passées avec --dart-define, jamais écrites en dur) ---
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# --- Edge Functions : cartes (services publics pour les essais, à héberger pour la production) ---
PHOTON_URL=
OSRM_URL=
GEO_USER_AGENT=

# --- Edge Functions : paiement de recharge (fournisseur non choisi) ---
PSP_NAME=
PSP_WEBHOOK_SECRET=

# --- Edge Functions : notifications push (projet Firebase créé par vous) ---
PUSH_DISPATCH_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# --- Authentification par SMS (fournisseur créé par vous : Twilio, Vonage, etc.) ---
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
